// Schema do Ascend (ver SPEC.md, seção 4).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Modelos do Auth.js
model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  concursos     Concurso[]
  rotina        Rotina?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Rate limit do login por OTP
model AuthAttempt {
  id        String   @id @default(cuid())
  email     String
  kind      String // "send" | "verify"
  createdAt DateTime @default(now())

  @@index([email, kind, createdAt])
}

// Domínio
model Concurso {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nome      String // ex.: "Escrevente — Ministério Público"
  banca     String?
  cargo     String?
  dataProva DateTime? @db.Date // só a data; interpretada no fuso America/Sao_Paulo
  cor       String    @default("blue")
  materias  Materia[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

// Rotina de estudos do usuário; vale para todos os concursos.
model Rotina {
  id            String @id @default(cuid())
  userId        String @unique
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  diasSemana    Int[] // 0 = domingo … 6 = sábado
  inicioMinutos Int // minutos desde 00:00 (840 = 14:00)
  minutosPorDia Int // tempo de estudo, sem contar as pausas
  duracaoBloco  Int    @default(60) // minutos de cada bloco (uma matéria por bloco)
  pausa         Int    @default(15) // minutos de descanso entre blocos
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
}

enum Dificuldade {
  FACIL
  NEUTRO
  DIFICIL
}

model Materia {
  id          String      @id @default(cuid())
  concursoId  String
  concurso    Concurso    @relation(fields: [concursoId], references: [id], onDelete: Cascade)
  nome        String
  peso        Int         @default(1) // 1 a 5
  prioridade  Prioridade  @default(MEDIA)
  dificuldade Dificuldade @default(NEUTRO)
  ordem       Int
  topicos     Topico[]

  @@index([concursoId])
}

enum StatusTopico {
  NAO_INICIADO
  TEORIA
  EXERCICIOS
  REVISADO
}

model Topico {
  id          String       @id @default(cuid())
  materiaId   String
  materia     Materia      @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  titulo      String
  ordem       Int
  status      StatusTopico @default(NAO_INICIADO)
  nota        String? // anotações livres
  dificuldade Dificuldade? // null = a da matéria
  links       String[]     @default([])
  updatedAt   DateTime     @updatedAt

  @@index([materiaId])
}
