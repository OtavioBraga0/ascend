# Supabase: use a connection string do pooler (Transaction, porta 6543) com ?pgbouncer=true
DATABASE_URL=
# Supabase: conexão direta ou Session pooler (porta 5432), usada pelo Prisma CLI nas migrations
DIRECT_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Envio do código por Gmail (OAuth2). Em desenvolvimento, se não estiverem
# definidas, o código é apenas logado no console.
GMAIL_OAUTH_USER=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
EMAIL_FROM="Ascend <nao-responda@seudominio.com>"
# Extração do edital com IA (opcional). Sem a chave, o botão não aparece.
OPENROUTER_API_KEY=""
# Modelo principal. Precisa suportar structured outputs (veja openrouter.ai/models, filtro "structured_outputs").
OPENROUTER_MODEL="google/gemini-2.5-flash"
# Modelos reserva, separados por vírgula (opcional).
OPENROUTER_FALLBACK_MODELS=""
# Opcional: esforço de raciocínio (none, minimal, low, medium, high). Modelos de
# raciocínio gastam tokens e tempo "pensando" antes de responder; "none" desliga.
# Todos os modelos acima precisam aceitar o valor (veja `reasoning` em
# https://openrouter.ai/api/v1/models), senão a chamada falha.
OPENROUTER_REASONING_EFFORT=""
