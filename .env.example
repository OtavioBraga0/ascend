# Supabase: use a connection string do pooler (Transaction, porta 6543) com ?pgbouncer=true
DATABASE_URL=
# Supabase: conexão direta ou Session pooler (porta 5432), usada pelo Prisma CLI nas migrations
DIRECT_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Envio do código por Gmail (OAuth2). Em desenvolvimento, se não estiverem
# definidas, o código é apenas logado no console.
GMAIL_OAUTH_USER=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
EMAIL_FROM="Ascend <nao-responda@seudominio.com>"
